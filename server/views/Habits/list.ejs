<style>
    body {
      background: #f5f5f0;
    }
</style>

<!-- main content for displaying database-->
<main class="container">

    <div class="row">
        <div class="offset-md-1 col-md-10">

            <h1>
                <%= title %>
            </h1>

            <a href="/habits/add" class="btn btn-success mb-3">
                <i class="fas fa-plus-circle"></i> Add a Habit
            </a>

            <table class="table table-bordered table-striped table-hover">

                <!-- Table Header -->
                <thead>
                    <tr class="d-flex text-center">
                        <th class="col-3">Habit Title</th>
                        <th class="col-2">Difficulty</th>
                        <th class="col-2">Frequency</th>
                        <th class="col-3">Purpose</th>
                    </tr>
                </thead>

                <tbody>
                    <% for (let i=0; i < HabitList.length; i++) { %>
                        <tr class="d-flex text-center">
                            <td class="col-3">
                                <%= HabitList[i].title %>
                            </td>
                            <td class="col-2">
                                <%= HabitList[i].difficulty %>
                            </td>
                            <td class="col-2">
                                <%= HabitList[i].frequency %>
                            </td>
                            <td class="col-3">
                                <%= HabitList[i].purpose %>
                            </td>

                            <!-- Edit Button -->
                            <td class="col-1 text-center">
                                <a href="/habits/edit/<%= HabitList[i]._id %>" class="btn btn-primary btn-sm">
                                    Edit
                                </a>
                            </td>
                            <!-- Delete Button -->
                            <td class="col-1 text-center">
                                <a href="/habits/delete/<%= HabitList[i]._id %>" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this habit?');">
                                    Delete
                                </a>
                            </td>

                        </tr>
                        <% } %>
                </tbody>

            </table>

        </div>
    </div>

</main>